{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "dev-localdb",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "TURSO_DATABASE_URL": "file:./data/stock.db",
        "TURSO_AUTH_TOKEN": ""
      }
    },
    {
      "name": "dev-copydb",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3000"
      ],
      "port": 3000,
      "env": {
        "TURSO_DATABASE_URL": "file:./data/dev-copy.db",
        "TURSO_AUTH_TOKEN": ""
      }
    }
  ]
}
